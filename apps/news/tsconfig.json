{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "disableSourceOfProjectReferenceRedirect": true,
    "incremental": true,
    "noEmit": true,
    "tsBuildInfoFile": "../../.cache/tsbuild/apps/news.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "instrumentation.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "references": [
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/news"
    },
    {
      "path": "../../packages/platform"
    },
    {
      "path": "../../tsconfig.prisma-client.json"
    }
  ]
}
