#!/bin/sh
# Pre-push hook: shared enforcement belongs to the remote base/head CI.

if [ "${WORKSPACE_REPO_RUNTIME_READY:-0}" != "1" ]; then
  repository_root="$(cd "$(dirname "$0")/.." && pwd)"
  exec "$repository_root/scripts/runtime/run-with-repo-node.sh" "$0" "$@"
fi

echo "→ Push source checks are enforced once by remote base/head affected CI."
