#!/bin/sh
# Pre-commit hook: validate the exact staged tree only.

if [ "${WORKSPACE_REPO_RUNTIME_READY:-0}" != "1" ]; then
  repository_root="$(cd "$(dirname "$0")/.." && pwd)"
  exec "$repository_root/scripts/runtime/run-with-repo-node.sh" "$0" "$@"
fi

echo "→ Running exact staged-tree pre-commit checks..."
npm run check:precommit || {
  echo "✗ Staged-tree pre-commit checks failed. Commit aborted."
  exit 1
}

echo "✓ Staged-tree pre-commit checks passed."
