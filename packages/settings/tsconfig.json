{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "../../.cache/types/packages/settings",
    "tsBuildInfoFile": "../../.cache/tsbuild/settings.tsbuildinfo"
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts", "**/*.json"],
  "exclude": ["node_modules"],
  "references": [{ "path": "../core" }, { "path": "../platform" }]
}
