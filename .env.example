# Required for production build and JWT cookie signing.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-secret
# ONLYOFFICE DocumentServer 与应用共享的 JWT 密钥；Office 原文件只读预览必填。
ONLYOFFICE_JWT_SECRET=replace-with-a-separate-long-random-secret
# DocumentServer 拉取签名原文件时使用的公网来源；生产建议显式配置，例如 https://example.com。
WORKSPACE_PUBLIC_ORIGIN=
# 签名内部 RPC 的可选受管 Gateway 覆盖；生产默认复用 WORKSPACE_PUBLIC_ORIGIN。
# WORKSPACE_INTERNAL_ORIGIN=http://127.0.0.1:3180

# Runtime config root. Keep it outside the source checkout.
WORKSPACE_CONFIG_DIR=/path/to/your/.workspace

# Deploy-unit internal RPC identity is created and injected by ops/apply-deploy-unit.sh.
# Do not put these runtime-managed values or any signing private key in the shared .env:
# WORKSPACE_DEPLOY_UNIT_ID
# WORKSPACE_INTERNAL_SIGNING_PRIVATE_KEY_FILE
# WORKSPACE_INTERNAL_TRUSTED_PUBLIC_KEYS_FILE
# WORKSPACE_INTERNAL_REPLAY_DIRECTORY

# PostgreSQL runtime URL used by PrismaPg. Production runtime.env contains this URL,
# but never DIRECT_URL or SHADOW_DATABASE_URL.
DATABASE_URL="postgresql://workspace_runtime:password@127.0.0.1:5432/workspace?sslmode=require"

# Production control-plane.env is root-only. The migrator logs in without inherited
# owner rights and explicitly SET ROLEs to the NOLOGIN owner for schema operations.
# Do not point this at a transaction-pooling endpoint.
DIRECT_URL="postgresql://workspace_migrator:password@127.0.0.1:5432/workspace?sslmode=require&options=-c%20role%3Dworkspace_owner"
WORKSPACE_BACKUP_DATABASE_URL="postgresql://workspace_backup:password@127.0.0.1:5432/workspace?sslmode=require"
WORKSPACE_MONITOR_DATABASE_URL="postgresql://workspace_monitor:password@127.0.0.1:5432/workspace?sslmode=require"

# Local/CI only: dedicated empty database used by prisma migrate dev/diff.
SHADOW_DATABASE_URL="postgresql://workspace:password@127.0.0.1:5432/workspace_shadow"

# PrismaPg/node-postgres pool settings. Keep the total across all processes below the server budget.
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000
PG_APPLICATION_NAME=workspace

# Tenant identity, organization, domain options, and provisioning data live in
# WORKSPACE_CONFIG_DIR/config/tenant/profile.json and its referenced files.

# Public base path for the app when deployed below a sub-path.
NEXT_PUBLIC_BASE_PATH=/workspace

# 企业微信登录（自建应用）
# WECHAT_CORP_ID=wwxxxxxxxxxxxxxxxx
# WECHAT_AGENT_ID=1000000
# WECHAT_SECRET=xxxxxxxxxxxxxxxx
# Optional: force OAuth callback origin when behind a reverse proxy.
# WECHAT_REDIRECT_ORIGIN=https://your-domain.example.com

# 企业微信智能机器人（API 模式：长连接）
# WECHAT_BOT_ID=your-bot-id
# WECHAT_BOT_SECRET=your-long-connection-secret
# Optional: defaults to the local Workspace integration route.
# WECHAT_BOT_BRIDGE_URL=http://127.0.0.1:3000/workspace/api/integrations/wecom/agent
# 数据质量主动群提醒使用独立的企业微信群机器人 webhook；不要与会话 Bot secret 混用。
# WECOM_DATA_QUALITY_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# DATA_QUALITY_SCHEDULER_DISABLED=1

# QC 配置源覆盖（只读）。默认读取 WORKSPACE_CONFIG_DIR/config/pharma-qc。
# WORKSPACE_QC_CONFIG_ROOT=/path/to/workspace/.workspace/config/pharma-qc

# 资料库（本地文件浏览器）配置
# 试验版：支持通过环境变量适配任意本地文件夹
# LIBRARY_SOURCE_ROOT — 只读扫描来源，不保存版本、manifest 或派生物
# LIBRARY_SOURCE_ROOT=/path/to/input/library
# LIBRARY_ROOT — 可写运行态资料目录，必须位于 WORKSPACE_CONFIG_DIR 下
# LIBRARY_ROOT=/path/to/.workspace/library
# LIBRARY_LABEL — 页面标题（默认"资料库"）
# LIBRARY_LABEL=资料库
# 资料库向量模型（默认使用固定版本的千问 Qwen3 Embedding 0.6B）
# LIBRARY_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# LIBRARY_EMBEDDING_MODEL_REVISION=master
# LIBRARY_EMBEDDING_MODEL_DIR=/path/to/.cache/workspace-library/models/Qwen3-Embedding-0.6B

# 本地数据导入脚本（scripts/import/*）使用的输入/输出目录
# COMPANY_TASK_PLANS_INPUT_DIR=/path/to/company-task-plans/RAW
# COMPANY_TASK_PLANS_OUTPUT_DIR=/path/to/company-task-plans

# Agent 智能助手默认使用 auto：所有 turn 先使用官方 Kimi Agent SDK + 固定版本 Kimi CLI；
# 配置 PI_DEEPSEEK_API_KEY 后，仅当 Kimi 在输出文本或调用 Workspace 工具前不可用时，
# 才由 Pi Agent + DeepSeek V4 Flash 安全接管。取消、图片 turn 和已开始执行的 turn 不重试。
# 可显式设为 auto、pi-deepseek 或 kimi。pi-deepseek 模式会跳过 Kimi，缺少 Key 时失败关闭。
# AGENT_RUNTIME_PROVIDER=auto
# PI_DEEPSEEK_API_KEY=replace-with-deepseek-api-key
# Kimi 模型、Coding Plan OAuth 或 Moonshot API Key 仍由
# WORKSPACE_CONFIG_DIR/runtime/kimi-agent 隔离运行时管理；不要恢复旧的
# AGENT_MODEL_PROVIDER、KIMI_API_KEY/KIMI_MODEL 或 DEEPSEEK_* 直连变量。
# Web 与企业微信共用固定的 3 个活跃 turn 槽位；该上限不可通过环境变量调高。
# Agent 会话默认写入 WORKSPACE_CONFIG_DIR/agent；覆盖目录时必须使用绝对路径，不能落到源码 checkout。
# AGENT_DATA_DIR=/absolute/path/to/.workspace/agent
# 页面助手固定为 API-only 薄壳，不配置源码、Git、PR、数据库或服务器访问能力。
