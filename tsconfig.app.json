{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "./.cache/types/app",
    "tsBuildInfoFile": "./.cache/tsbuild/app.tsbuildinfo",
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "instrumentation.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.mts",
    "app/**/*.cts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".cache"],
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/platform" },
    { "path": "./packages/administration" },
    { "path": "./packages/agent" },
    { "path": "./packages/capital-securities" },
    { "path": "./packages/docs" },
    { "path": "./packages/external" },
    { "path": "./packages/finance" },
    { "path": "./packages/hr" },
    { "path": "./packages/inventory" },
    { "path": "./packages/library" },
    { "path": "./packages/production" },
    { "path": "./packages/settings" },
    { "path": "./packages/work" }
  ]
}
