[Unit]
Description=Workspace PostgreSQL isolated restore drill
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/workspace/postgresql/backup.env
ExecStart=/usr/local/lib/workspace-postgresql/restore-drill.sh
UMask=0077
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/workspace/postgresql-restore-drills
ReadOnlyPaths=/var/backups/workspace/postgresql
TimeoutStartSec=3h

[Install]
WantedBy=multi-user.target
