# Copy the existing non-database application settings into app.env.
# DATABASE_URL, DIRECT_URL, SHADOW_DATABASE_URL, PGPASSWORD, and PGOPTIONS are forbidden here.
WORKSPACE_PUBLIC_ORIGIN=https://fh-bio.cn/test
WORKSPACE_CONFIG_DIR=/workspace-runtime
NEXT_PUBLIC_BASE_PATH=/test
MARKET_INTELLIGENCE_AKTOOLS_BASE_URL=http://market-data:8080
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_APPLICATION_NAME=workspace-dev-app
WORKSPACE_SQL_SETTINGS_REQUEST_HMAC_FILE=/run/secrets/workspace_dev_sql_settings_request_hmac
