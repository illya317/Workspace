[Unit]
Description=Workspace development PostgreSQL settings worker
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/usr/local/lib/workspace-postgresql-dev
Environment=WORKSPACE_SQL_SETTINGS_EXECUTE=1
Environment=WORKSPACE_DEV_POSTGRESQL_COMPOSE_ROOT=/home/ubuntu/workspace-dev/postgresql-security
ExecStart=/usr/local/lib/workspace-postgresql-dev/sql-settings-worker.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/workspace-dev/postgresql-security/secrets /var/lib/workspace-postgresql-dev /run/docker.sock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=workspace-dev-postgresql-settings

[Install]
WantedBy=multi-user.target
