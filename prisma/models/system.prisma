/// 系统配置键值对
model SystemConfig {
  key   String @id
  value String
}

/// 关系治理策略的当前有效覆盖；空 settingsJson 表示已显式重置到代码基线
model RelationPolicyConfig {
  policyKey       String                   @id
  settingsJson    Json
  baselineHash    String
  version         Int                      @default(1)
  updatedByUserId Int?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @default(now()) @updatedAt
  updatedBy       User?                    @relation("RelationPolicyConfigUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

/// 关系治理策略的追加式修订历史；主配置重置后仍保留完整审计链
model RelationPolicyRevision {
  id           Int      @id @default(autoincrement())
  policyKey    String
  version      Int
  changeKind   String
  reason       String?
  settingsJson Json
  baselineHash String
  actorUserId  Int?
  createdAt    DateTime @default(now())
  actor        User?    @relation("RelationPolicyRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([policyKey, version])
  @@index([actorUserId, createdAt])
}

/// 业务编码的服务端原子流水；scopeKey 由各领域按公司、分类、年度等稳定维度组成
model BusinessCodeSequence {
  ruleKey    String
  scopeKey   String
  nextValue  Int      @default(1)
  updatedAt  DateTime @default(now()) @updatedAt

  @@id([ruleKey, scopeKey])
}

/// 当前生效的业务编码规则；修改配置时保留稳定 id 并递增 version
model BusinessCodeRule {
  id          Int                      @id @default(autoincrement())
  objectKey   String                   @unique
  configJson  Json
  version     Int                      @default(1)
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @default(now()) @updatedAt
  allocations BusinessCodeAllocation[]
}

/// 已分配业务编码凭证；保存规则版本、渲染结果和幂等键，既有记录不随规则变化重算
model BusinessCodeAllocation {
  id              Int              @id @default(autoincrement())
  objectKey       String
  idempotencyKey  String
  inputFingerprint String
  ruleId          Int
  ruleVersion     Int
  scopeKey        String
  sequence        Int
  code            String
  createdAt       DateTime         @default(now())
  rule            BusinessCodeRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([objectKey, idempotencyKey])
  @@unique([objectKey, code])
  @@unique([ruleId, ruleVersion, scopeKey, sequence])
  @@index([ruleId, scopeKey])
}

/// 登录尝试审计日志
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  username  String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())
}
