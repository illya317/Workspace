/// OKR 周期事实表（系统生成/管理员确认；统一维护年、半年、季度、月、周的固定起止）
model WorkOkrCycle {
  id         Int                    @id @default(autoincrement())
  periodType String
  code       String                 @unique
  label      String
  year       Int
  sequence   Int
  parentId   Int?
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @default(now()) @updatedAt
  parent     WorkOkrCycle?          @relation("WorkOkrCycleHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   WorkOkrCycle[]         @relation("WorkOkrCycleHierarchy")
  plans      WorkPlan[]
  policies   WorkOkrControlPolicy[]

  @@index([periodType, year, sequence])
  @@index([parentId])
  @@index([startDate, endDate])
}

/// OKR 周期管控策略（管理员配置；只控制锁定/开放，不替代空间权限或流程策略）
model WorkOkrControlPolicy {
  id                      Int          @id @default(autoincrement())
  cycleId                 Int
  scopeType               String       @default("global")
  scopeId                 String       @default("")
  isLocked                Boolean      @default(false)
  objectiveSubmitDeadline DateTime?
  krReviewOpensAt         DateTime?
  krSubmitDeadline        DateTime?
  version                 Int          @default(1)
  createdByUserId         Int?
  updatedByUserId         Int?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @default(now()) @updatedAt
  cycle                   WorkOkrCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([krReviewOpensAt])
}

/// OKR 全局时间管控配置版本（append-only 事实表，来源于管理员保存）
model WorkOkrControlRevision {
  id           Int      @id @default(autoincrement())
  version      Int      @unique
  settingsJson String
  actorUserId  Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// OKR 周期例外策略版本（append-only 事实表，来源于管理员保存或开放时间调整）
model WorkOkrControlPolicyRevision {
  id           Int      @id @default(autoincrement())
  policyId     Int?
  cycleId      Int
  scopeType    String
  scopeId      String   @default("")
  version      Int
  changeKind   String   @default("upsert")
  snapshotJson String
  actorUserId  Int?
  createdAt    DateTime @default(now())

  @@index([cycleId, scopeType, scopeId, version])
  @@index([policyId, version])
}

/// 工作计划治理模式迁移事件（append-only 事实表，记录显式 workflow/direct 切换）
model WorkPlanGovernanceEvent {
  id               Int      @id @default(autoincrement())
  workPlanId       Int
  fromMode         String
  toMode           String
  fromSnapshotJson String   @default("{}")
  toSnapshotJson   String   @default("{}")
  reason           String
  actorUserId      Int?
  createdAt        DateTime @default(now())
  workPlan         WorkPlan @relation(fields: [workPlanId], references: [id], onDelete: Cascade)

  @@index([workPlanId, createdAt])
  @@index([actorUserId, createdAt])
}
