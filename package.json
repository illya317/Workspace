{
  "name": "workspace",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "dev:clean": "npm run dev",
    "build": "node scripts/check/with-check-lock.js -- npm run build:inner",
    "build:inner": "npm run db:generate:inner && npm run build:next:inner",
    "build:next": "node scripts/check/with-check-lock.js -- npm run build:next:inner",
    "build:next:inner": "npm run output-tracing:prepare && env NODE_OPTIONS=--max-old-space-size=4096 next build && npm run output-tracing:check",
    "start": "next start",
    "lint": "node scripts/check/with-check-lock.js -- eslint --cache --cache-location .cache/eslint/.eslintcache",
    "lint:api-response-format": "node scripts/check/with-check-lock.js -- node scripts/check/check-api-response-format.js",
    "lint:history-policy": "node scripts/check/with-check-lock.js -- npx tsx scripts/check/check-history-policy-registry.ts",
    "action-registry:check": "node scripts/check/with-check-lock.js -- npx tsx scripts/check/check-action-registry.ts",
    "business-action-registry:check": "node scripts/check/with-check-lock.js -- npx tsx scripts/check/check-business-action-registry.ts",
    "action-contract:check": "node scripts/check/with-check-lock.js -- npx tsx scripts/check/check-action-contracts.ts",
    "lint:changed": "node scripts/check/with-check-lock.js -- node scripts/check/run-eslint-changed.js",
    "complexity:line-budget": "node scripts/check/with-check-lock.js -- node scripts/check/check-net-line-growth.js",
    "complexity:split-quality": "node scripts/check/with-check-lock.js -- node scripts/check/check-split-quality.js",
    "lint:full": "npm run lint -- --max-warnings=0",
    "typecheck:quick": "env NODE_OPTIONS=--max-old-space-size=4096 node scripts/check/with-check-lock.js -- npx tsc --noEmit --incremental --tsBuildInfoFile .cache/tsconfig.quick.tsbuildinfo --pretty false",
    "typecheck:full": "env NODE_OPTIONS=--max-old-space-size=4096 node scripts/check/with-check-lock.js -- npx tsc --noEmit",
    "domain:changed": "node scripts/check/with-check-lock.js -- node scripts/check/run-domain-validation-changed.js",
    "db:migration:changed": "node scripts/check/with-check-lock.js -- node scripts/check/run-prisma-migrations-changed.js",
    "check:precommit": "npm run check:changed",
    "check:changed": "npm run playwright:lifecycle:check && npm run lint:changed && npm run domain:changed && npm run db:migration:changed && npm run typecheck:quick && npm run playwright:processes:check",
    "check:refactor": "npm run complexity:split-quality && npm run lint:changed && npm run typecheck:quick",
    "check:quick": "npm run env:check && npm run check:changed",
    "check:blockers": "npm run gate:business-identity && npm run gate:domain && npm run gate:ui",
    "check:arch": "npm run check:blockers",
    "check:data": "npm run db:validate && npm run schema:check && npm run db:migration:check && npm run docs-editor:official-templates:check",
    "check:hygiene": "node scripts/check/run-hygiene-strict.js",
    "check:hygiene:warn": "node scripts/check/run-hygiene-warning.js",
    "check:ci": "npm run playwright:lifecycle:check && npm run check:blockers && npm run env:check && npm run db:path:check && npm run docs:check && npm run check:data && npm run db:generate && npm run lint:api-response-format && npm run lint:full && npm run test:capacity:workflow && npm run test:capacity:hr && npm run typecheck:full && npm run build:next && npm run check:hygiene:warn && npm run playwright:processes:check",
    "check:full": "npm run check:ci",
    "deploy:preflight": "node scripts/check/check-deploy-preflight.js",
    "deploy:preflight:ci": "node scripts/check/check-deploy-preflight.js --ci",
    "ci": "npm run check:ci",
    "test": "npm run typecheck:quick",
    "test:capacity:workflow": "node --experimental-test-module-mocks --conditions=react-server --import tsx --test packages/work/server/task-approval-handlers.test.ts",
    "test:capacity:hr": "node --experimental-test-module-mocks --conditions=react-server --import tsx --test packages/hr/server/contracts-capacity.test.ts packages/hr/server/hr-tab-list-capacity.test.ts packages/hr/server/roster-generated-capacity.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "playwright:lifecycle:check": "node scripts/check/with-check-lock.js -- tsx scripts/check/check-playwright-lifecycle.ts",
    "playwright:processes:check": "node scripts/check/with-check-lock.js -- tsx scripts/check/check-playwright-processes.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "arch:gate": "node scripts/check/with-check-lock.js -- tsx scripts/arch/gate.ts",
    "gate:business-identity": "node scripts/check/with-check-lock.js -- node scripts/check/check-business-identity-boundary.js",
    "gate:domain": "npm run action-registry:check && npm run business-action-registry:check && npm run action-contract:check && node scripts/check/with-check-lock.js -- tsx scripts/arch/domain-gate.ts && npm run arch:structure:domain",
    "gate:ui": "node scripts/check/with-check-lock.js -- tsx scripts/arch/ui-gate.ts && npm run core-ui:contracts:check && npm run arch:structure:ui",
    "arch:structure": "tsx scripts/arch/structure.ts",
    "arch:structure:ratchet": "node scripts/check/with-check-lock.js -- tsx scripts/arch/structure-enforce.ts",
    "arch:structure:domain": "node scripts/check/with-check-lock.js -- tsx scripts/arch/structure-enforce.ts --scope=domain-blocker",
    "arch:structure:ui": "node scripts/check/with-check-lock.js -- tsx scripts/arch/structure-enforce.ts --scope=ui-blocker",
    "arch:structure:hygiene": "node scripts/check/with-check-lock.js -- tsx scripts/arch/structure-enforce.ts --scope=hygiene",
    "arch:surface-boundaries": "tsx scripts/arch/surface-boundaries.ts",
    "arch:create-surface-entry": "tsx scripts/arch/create-surface-entry.ts",
    "arch:surface-page-adoption": "tsx scripts/arch/surface-page-adoption.ts",
    "arch:surface-visualization-adoption": "tsx scripts/arch/surface-visualization-adoption.ts",
    "arch:ui-helper-purity": "tsx scripts/arch/ui-helper-purity.ts",
    "db:check": "node scripts/check/check-db.js",
    "db:path:check": "node scripts/check/check-database-paths.js",
    "db:docs": "node scripts/generate/gen-db-docs.js",
    "db:resource-manifest": "npx tsx scripts/write-resource-manifest.ts",
    "db:seed:resources": "npx tsx scripts/seed-resources.ts",
    "db:permission-actions:check": "npx tsx scripts/write-resource-manifest.ts .cache/resource-defs.json && node scripts/check/check-permission-action-grants.mjs .cache/resource-defs.json",
    "db:backfill:permission-ledger": "npx tsx scripts/backfill-permission-grant-ledger.ts",
    "db:generate": "node scripts/check/with-check-lock.js -- npm run db:generate:inner",
    "db:generate:inner": "prisma generate --schema=./prisma",
    "db:validate": "node scripts/check/with-check-lock.js -- prisma validate --schema=./prisma",
    "db:migration:check": "node scripts/check/with-check-lock.js -- node scripts/check/check-prisma-migrations.js",
    "db:deploy-status": "node scripts/check/check-prisma-deploy-status.js",
    "db:migrate:sqlite-to-postgresql": "node scripts/migrate/sqlite-to-postgresql.mjs",
    "db:postgresql:smoke": "npx tsx scripts/postgresql-runtime-smoke.ts",
    "db:postgresql:ci-smoke": "npx tsx scripts/postgresql-ci-smoke.ts && npm run db:postgresql:notification-capacity",
    "db:postgresql:notification-capacity": "env PG_POOL_MAX=10 PG_CONNECTION_TIMEOUT_MS=5000 node --conditions=react-server --import tsx scripts/postgresql-notification-capacity.ts",
    "db:format": "prisma format --schema=./prisma",
    "env:check": "node scripts/check/check-env.js",
    "workspace:check": "node scripts/check/check-workspace-runtime.js",
    "qc:cache:build": "npx tsx scripts/build-qc-template-cache.ts",
    "docs-editor:content:rehome": "npx tsx scripts/rehome-docs-editor-content.ts",
    "docs-editor:official-templates:check": "node scripts/check/check-docs-editor-official-templates.js",
    "schema:check": "node scripts/check/with-check-lock.js -- node scripts/check/check-schema-governance.js",
    "api:check": "npm run arch:gate",
    "docs:action-contracts": "npx tsx scripts/generate-action-contract-docs.ts",
    "docs:action-contracts:check": "node scripts/check/with-check-lock.js -- npx tsx scripts/generate-action-contract-docs.ts --check",
    "output-tracing:check": "node scripts/check/check-standalone-tracing.js",
    "output-tracing:prepare": "node scripts/check/prepare-standalone-output.js",
    "docs:check": "node scripts/check/with-check-lock.js -- node scripts/check/check-architecture-docs.js && npm run docs:action-contracts:check",
    "company:check": "node scripts/check/with-check-lock.js -- node scripts/check/check-company-hardcoding.js",
    "core-ui:contracts": "tsx scripts/generate-core-ui-surface-contracts.ts",
    "core-ui:contracts:check": "node scripts/check/with-check-lock.js -- tsx scripts/generate-core-ui-surface-contracts.ts --check",
    "deps:snapshot:sync": "node scripts/sync-external-snapshots.mjs",
    "budget:sync-accounts": "node scripts/sync-budget-accounts.js",
    "finance:cashflow-import": "npx tsx scripts/import-cash-flow-workpapers.ts",
    "finance:cashflow-import:execute": "npx tsx scripts/import-cash-flow-workpapers.ts --execute",
    "work:company-tasks:clean": "npx tsx scripts/import/clean-company-task-plans.ts",
    "work:company-projects:import": "npx tsx scripts/import/import-company-priority-projects.ts",
    "work:project-codes:recode": "npx tsx scripts/migrate/recode-work-project-codes.ts",
    "work:project-codes:recode:execute": "npx tsx scripts/migrate/recode-work-project-codes.ts --execute",
    "db:seed:library-generated": "npx tsx scripts/seed-library-generated-sources.ts",
    "db:scan:library": "npx tsx scripts/scan-library.ts",
    "library:deps:install": "bash ops/install-library-runtime-deps.sh",
    "library:deps:check": "bash ops/install-library-runtime-deps.sh --check",
    "library:deps:smoke": "bash ops/install-library-runtime-deps.sh --check --smoke",
    "library:pilot:prepare": "npx tsx scripts/prepare-library-pilot.ts",
    "library:pilot:check": "npx tsx scripts/prepare-library-pilot.ts --check",
    "library:scan:smoke": "npx tsx scripts/library-scan-smoke.ts",
    "library:scan:check": "npx tsx scripts/check-library-scan-manifest.ts",
    "library:process:version": "npx tsx scripts/process-library-version.ts",
    "library:process:pilot": "npx tsx scripts/process-library-pilot.ts",
    "library:preview:version": "npx tsx scripts/preview-library-version.ts",
    "library:preview:batch": "npx tsx scripts/preview-library-batch.ts",
    "library:compress:batch": "npx tsx scripts/compress-library-batch.ts",
    "library:compact": "npx tsx scripts/compact-library-runtime.ts",
    "library:catalog:import": "npx tsx scripts/import-library-catalog.ts",
    "library:search": "npx tsx scripts/search-library.ts",
    "library:export": "NODE_OPTIONS='--conditions=react-server' npx tsx scripts/export-library-selection.ts",
    "library:incremental": "npx tsx scripts/run-library-incremental.ts",
    "agent:runtime:install": "bash ops/install-kimi-agent-runtime.sh",
    "agent:runtime:check": "bash ops/install-kimi-agent-runtime.sh --check",
    "agent:runtime:login": "bash ops/install-kimi-agent-runtime.sh --login"
  },
  "prisma": {
    "schema": "./prisma"
  },
  "dependencies": {
    "@moonshot-ai/kimi-agent-sdk": "0.1.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tiptap/core": "3.27.1",
    "@tiptap/extension-subscript": "3.27.1",
    "@tiptap/extension-superscript": "3.27.1",
    "@tiptap/extension-table": "3.27.1",
    "@tiptap/extension-table-cell": "3.27.1",
    "@tiptap/extension-table-header": "3.27.1",
    "@tiptap/extension-table-row": "3.27.1",
    "@tiptap/extension-text-align": "3.27.1",
    "@tiptap/extension-underline": "3.27.1",
    "@tiptap/pm": "3.27.1",
    "@tiptap/react": "3.27.1",
    "@tiptap/starter-kit": "3.27.1",
    "@wecom/aibot-node-sdk": "1.0.7",
    "bcryptjs": "^3.0.3",
    "bpmn-js": "^18.19.0",
    "docx": "9.7.1",
    "dotenv": "^17.4.2",
    "hyperformula": "3.3.0",
    "iconv-lite": "^0.7.2",
    "jose": "^6.2.3",
    "lucide-react": "1.22.0",
    "next": "16.2.6",
    "pg": "^8.22.0",
    "pinyin-pro": "^3.28.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/iconv-lite": "^0.0.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^11.10.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "prisma-docs-generator": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
